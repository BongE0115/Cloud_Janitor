# Detection policy
LIMIT_CPU_M=10.0
TIME_WINDOW_CPU=2m
LIMIT_NET_B=100.0
TIME_WINDOW_NET=2m
DRY_RUN=True

# Cost estimate
COST_PER_CORE_HOUR=0.1
DEFAULT_CPU_REQ=0.2

# Database / Grafana
DB_HOST=mysql.mysql.svc.cluster.local
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=janitor_db
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Loki (container metadata lookup / target promtail)
LOKI_URL=http://host.docker.internal:31000
