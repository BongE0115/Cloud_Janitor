# Detection policy
LIMIT_CPU_M=10.0
TIME_WINDOW_CPU=2m
LIMIT_NET_B=100.0
TIME_WINDOW_NET=2m
DRY_RUN=True
GRACE_PERIOD_MINUTES=10

# Alert timing (Grafana)
ALERT_PENDING_FOR=0s
ALERT_DELETED_FOR=30s
ALERT_RULE_INTERVAL_SECONDS=30
ALERT_GROUP_WAIT=0s
ALERT_GROUP_INTERVAL=1m
ALERT_REPEAT_INTERVAL=24h

# Cost estimate
COST_PER_CORE_HOUR=0.1
DEFAULT_CPU_REQ=0.2

# Database / Grafana
DB_HOST=mysql.mysql.svc.cluster.local
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=janitor_db
GRAFANA_HOST_PORT=3000
MYSQL_HOST_PORT=3306
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Deferred cleanup target Docker API
DOCKER_API_URL=unix:///var/run/docker.sock

# SMTP / Alerting
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=alert@example.com
SMTP_PASSWORD=app-password
SMTP_FROM_ADDRESS=alert@example.com
SMTP_FROM_NAME=Cloud-Janitor-Alert
SMTP_STARTTLS_POLICY=MandatoryStartTLS
ALERT_EMAILS=alert@example.com

# Loki (container metadata lookup / target promtail)
LOKI_URL=http://host.docker.internal:31000

# Cloud Janitor Base URL (for email action links)
CJ_BASE_URL=http://localhost:30800

# Cost model parameters
BASE_POD_COST_PER_HOUR=0.02

# These rates are used to estimate the cost of wasted resources. They can be overridden by environment variables or config file values.
CPU_COST_PER_M_PER_SEC=0.0000001
MEM_COST_PER_MI_PER_SEC=0.00000005