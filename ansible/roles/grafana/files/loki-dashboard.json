{
  "id": null,
  "uid": "cloud-janitor-dashboard",
  "title": "Cloud Janitor - dashboard",
  "folderUid": "",
  "refresh": "5s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values(namespace)",
        "query": "label_values(namespace)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "현재 좀비 수",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-main" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(zombie_count), 0) AS value FROM scan_latest_summary;"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }
      }
    },
    {
      "type": "stat",
      "title": "현재 후보 수",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-main" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(candidate_count), 0) AS value FROM scan_latest_summary;"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }
      }
    },
    {
      "type": "stat",
      "title": "누적 좀비 수 (정지/삭제)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-main" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value FROM zombie_lifecycle WHERE status IN ('STOPPED','DELETED');"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }
      }
    },
    {
      "type": "stat",
      "title": "비용 절감 추정 비용",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-main" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ROUND(COALESCE(SUM(wasted_cost), 0), 2) AS value FROM zombie_lifecycle WHERE status IN ('STOPPED','DELETED');"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "감지 추이 (Zombie / Candidate / Active)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "timeFrom": "1h",
      "interval": "1m",
      "maxDataPoints": 60,
      "targets": [
        {
          "expr": "max(last_over_time({app=~\"cloud-janitor|cloud-janitor-scanner\", namespace=~\"$namespace\"} |= \"SCAN_CYCLE_END\" | logfmt | unwrap zombie [1m]))",
          "legendFormat": "Zombie",
          "refId": "A"
        },
        {
          "expr": "max(last_over_time({app=~\"cloud-janitor|cloud-janitor-scanner\", namespace=~\"$namespace\"} |= \"SCAN_CYCLE_END\" | logfmt | unwrap candidate [1m]))",
          "legendFormat": "Candidate",
          "refId": "B"
        },
        {
          "expr": "max(last_over_time({app=~\"cloud-janitor|cloud-janitor-scanner\", namespace=~\"$namespace\"} |= \"SCAN_CYCLE_END\" | logfmt | unwrap active [1m]))",
          "legendFormat": "Active",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barWidthFactor": 1,
            "barAlignment": 0,
            "fillOpacity": 100,
            "lineWidth": 1,
            "pointSize": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "네트워크 사용량 (컨테이너별, RX+TX)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "max by (tc_container) (last_over_time({app=~\"cloud-janitor|cloud-janitor-scanner\"} |= \"SCAN_CONTAINER\" | logfmt | unwrap net_b [5m]))",
          "legendFormat": "{{tc_container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "type": "table",
      "title": "현재 감지 컨테이너 상태 (Latest Scan)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "mysql", "uid": "mysql-main" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT c.tc_name, c.tc_container, ROUND(c.cpu_m, 2) AS cpu_m, ROUND(c.mem_mi, 2) AS mem_mi, ROUND(c.net_b, 2) AS net_b, c.ctype, c.decision, c.reason FROM scan_latest_containers c JOIN scan_latest_summary s ON s.tc_name = c.tc_name AND s.cycle_id = c.cycle_id ORDER BY c.net_b DESC, c.tc_container;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "net_b" },
            "properties": [{ "id": "unit", "value": "Bps" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "net_b",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Janitor API 로그 (cloud-janitor)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "{app=\"cloud-janitor\", namespace=~\"$namespace\"} != \"GET /ready\" != \"GET /health\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending"
      }
    },
    {
      "type": "logs",
      "title": "Janitor Scanner 로그 (cloud-janitor-scanner)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "{app=\"cloud-janitor-scanner\", namespace=~\"$namespace\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending"
      }
    }
  ]
}
