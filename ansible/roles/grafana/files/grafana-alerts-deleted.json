{
  "uid": "deleted-alerts",
  "title": "좀비 컨테이너 삭제 완료",
  "ruleGroup": "CloudJanitorAlerts",
  "folderUID": "",
  "condition": "C",
  "for": "0s",
  "noDataState": "OK",
  "execErrState": "Error",
  "labels": {
    "team": "cloud-janitor",
    "severity": "info",
    "event": "delete_completed"
  },
  "annotations": {
    "summary": "[Cloud Janitor] 삭제 완료",
    "description": "최근 10분 내 삭제 완료(DELETED) 컨테이너가 {{ $values.B.Value }}개 처리되었습니다.\n\n📋 삭제된 컨테이너:\n{{ $values.D.Value }}"
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "__MYSQL_DS_UID__",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "model": {
        "format": "time_series",
        "instant": true,
        "rawSql": "SELECT NOW() AS time, COUNT(*) AS value FROM zombie_lifecycle WHERE status='DELETED' AND deleted_at IS NOT NULL AND deleted_at >= UTC_TIMESTAMP() - INTERVAL 10 MINUTE;"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "settings": { "mode": "dropNN" }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0] },
            "operator": { "type": "and" },
            "reducer": { "type": "last" },
            "type": "query"
          }
        ]
      }
    },
    {
      "refId": "D",
      "datasourceUid": "__MYSQL_DS_UID__",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "model": {
        "format": "table",
        "instant": true,
        "rawSql": "SELECT GROUP_CONCAT(CONCAT('\\n• ', tc_name, '/', container_name, ' (삭제시간: ', deleted_at, ')') SEPARATOR '') AS details FROM zombie_lifecycle WHERE status='DELETED' AND deleted_at IS NOT NULL AND deleted_at >= UTC_TIMESTAMP() - INTERVAL 10 MINUTE ORDER BY deleted_at DESC LIMIT 10;"
      }
    },
    {
      "refId": "D1",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "D",
        "reducer": "last",
        "settings": { "mode": "dropNN" }
      }
    }
  ]
}
