{
  "title": "파드 삭제 예정 예고",
  "ruleGroup": "CloudJanitorAlerts",
  "folderUID": "general",
  "condition": "A",
  "for": "1m",
  "noDataState": "OK",
  "execErrState": "Error",
  "labels": {
    "team": "cloud-janitor",
    "severity": "warning"
  },
  "annotations": {
    "summary": "삭제 예정 파드가 존재합니다.",
    "description": "DB(pending_deletion_pods) 기준으로 삭제 예정인 파드가 감지되었습니다."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "__MYSQL_DS_UID__",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "model": {
        "rawSql": "SELECT COUNT(*) AS value FROM pending_deletion_pods WHERE deletion_due_date <= DATE_ADD(NOW(), INTERVAL 1 HOUR) AND status = 'pending';",
        "format": "table"
      }
    }
  ]
}
