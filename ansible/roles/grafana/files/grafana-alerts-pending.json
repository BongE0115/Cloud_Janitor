{
  "uid": "pending-alerts",
  "title": "좀비 파드 삭제 예정",
  "ruleGroup": "CloudJanitorAlerts",
  "folderUID": "cloud-janitor",
  "condition": "C",
  "for": "1m",
  "noDataState": "OK",
  "execErrState": "OK",
  "labels": {
    "team": "cloud-janitor",
    "severity": "warning",
    "event": "delete_scheduled"
  },
  "annotations": {
    "summary": "[Cloud Janitor] 좀비 파드 삭제 예정 알림",
    "description": "새로운 좀비 파드 {{ $values.B.Value }}개가 감지되었습니다.\n\n※ 자세한 내용은 그라파나 대시보드를 참조하세요."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "__MYSQL_DS_UID__",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "model": {
        "format": "time_series",
        "instant": true,
        "rawSql": "SELECT NOW() AS time, COUNT(*) AS value FROM zombie_lifecycle WHERE status='PENDING' AND detected_at >= NOW() - INTERVAL 10 MINUTE;"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "settings": { "mode": "dropNN" }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0] },
            "operator": { "type": "and" },
            "reducer": { "type": "last" },
            "type": "query"
          }
        ]
      }
    }
  ]
}
